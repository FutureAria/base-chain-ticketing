# Frontend environment variables
# Copy this file to .env and fill values for your local machine.

# Backend API URL
VITE_API_URL=http://localhost:4000

# Oracle demo build:
# npm run build:oracle
# VITE_API_URL=https://juyoung-basechain.duckdns.org

# Google OAuth client id
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# TicketNFT contract address for Hoodi testnet or local testnet
VITE_CONTRACT_ADDRESS=YOUR_TICKET_NFT_CONTRACT_ADDRESS

# Toss Payments client key
VITE_TOSS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY

# 시연 전용: MetaMask 없이도 재판매 등록이 되도록 가짜 서명을 만들어 보낸다.
#
# ⚠️ 서버의 DEMO_ALLOW_MOCK_SIGNATURE 와 반드시 같은 값이어야 한다.
#    한쪽만 true 면 프론트는 가짜 서명을 만들고 서버는 거부해서,
#    MetaMask 가 없는 사용자에게 "서명을 검증할 수 없습니다" 오류만 보인다.
#
# true 로 두면 "지갑 서명으로 판매자 본인 확인"이라는 보증이 사라진다.
# 실제 검증을 보여줘야 하는 자리라면 false 로 두고 MetaMask 로 시연할 것.
VITE_DEMO_ALLOW_MOCK_SIGNATURE=false
