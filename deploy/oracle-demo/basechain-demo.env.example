# BASE CHAIN Oracle demo backend env
# Copy to server/.env on the Oracle VM and fill only non-secret demo values.

NODE_ENV=production
PORT=4000

# Public URLs must be HTTPS for mobile QR camera access.
PUBLIC_WEB_URL=https://basechain.example.com
PUBLIC_API_URL=https://basechain.example.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=basechain_demo
DB_PASSWORD=CHANGE_ME_DEMO_DB_PASSWORD
# ⚠️ true 로 두면 서버가 재시작될 때마다 DB를 통째로 지운다. 운영에서는 반드시 false.
RESET_DB_ON_START=false

# 관리자 계정
# 비워두면 계정이 생성되지 않고, 공지 작성·QR 검표·정산·추첨을 아무도 쓸 수 없다.
# 소스에 비밀번호를 박아두지 않으므로 여기서 반드시 설정할 것 (12자 이상 무작위).
DEMO_ADMIN_EMAIL=admin@basechain.example.com
DEMO_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ROOT_ADMIN_EMAIL=gate@basechain.example.com
ROOT_ADMIN_PASSWORD=CHANGE_ME_STRONG_GATE_PASSWORD

# CORS — 배포 도메인을 넣지 않으면 브라우저 요청이 차단된다.
FRONTEND_ORIGINS=https://basechain.example.com
# ngrok 와일드카드·사설 IP 허용. 개발할 때만 true.
CORS_ALLOW_DEV_ORIGINS=false
# Caddy 등 리버스 프록시 단 수 (실제 클라이언트 IP를 얻어 레이트리밋에 사용).
TRUST_PROXY_HOPS=1

# 레이트 리밋
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERAL_MAX=300

# Auth and QR signing
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
QR_SECRET=CHANGE_ME_LONG_RANDOM_QR_SECRET
QR_SLOT_SECONDS=10
QR_DEMO_ALWAYS_ON_GAME_IDS=PRACTICE_ALL_DAY_GAME
RAFFLE_DEMO_ALWAYS_OPEN_GAME_IDS=PRESENTATION_RAFFLE_ALWAYS_ON
DEMO_PRESENTATION_AUTO_GRANT=true
DEMO_PRESENTATION_EMAILS=demo1@example.com,demo2@example.com
DID_PEPPER=CHANGE_ME_LONG_RANDOM_DID_PEPPER

# Demo safety: keep all external money/chain integrations mocked.
FABRIC_MODE=mock
TOSS_MODE=mock
ENABLE_ONCHAIN_MINTING=false

# MetaMask 없이도 재판매 등록이 되도록 서명 검증을 건너뛴다.
# ⚠️ 프론트의 VITE_DEMO_ALLOW_MOCK_SIGNATURE 와 반드시 같은 값이어야 한다.
#    다르면 프론트는 가짜 서명을 만들고 서버는 거부해서 오류만 남는다.
# true 로 두면 "지갑 서명으로 판매자 본인 확인"이라는 보증이 사라진다.
DEMO_ALLOW_MOCK_SIGNATURE=false

# Keep these unset or placeholder in Oracle demo.
MINTER_PRIVATE_KEY=YOUR_MINTER_PRIVATE_KEY
FRAGMENT_NFT_ADDRESS=YOUR_FRAGMENT_NFT_ADDRESS
TICKET_NFT_ADDRESS=YOUR_TICKET_NFT_ADDRESS
BOX_NFT_ADDRESS=YOUR_BOX_NFT_ADDRESS
TICKET_MARKETPLACE_ADDRESS=YOUR_TICKET_MARKETPLACE_ADDRESS

# Toss demo placeholders. Do not put real secret keys in the demo env.
TOSS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY
TOSS_SECRET_KEY=YOUR_TOSS_SECRET_KEY

# Google OAuth, if used in the demo.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://basechain.example.com/

# Local testing helpers should normally stay neutral in Oracle demo.
DEBUG_TIME_OFFSET_HOURS=0
QR_HOURS_BEFORE=2
