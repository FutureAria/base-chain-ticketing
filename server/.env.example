# Backend environment variables
# Copy this file to .env and fill values for your local machine.

PORT=4000
NODE_ENV=development
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
# true로 두면 서버 시작 시 DB를 통째로 초기화한다. 운영에서는 반드시 false.
RESET_DB_ON_START=false

# 관리자 계정
# 비워두면 관리자 계정을 아예 만들지 않는다.
# (소스에 비밀번호를 박아두면 저장소를 공개하는 순간 운영 서버 관리자 권한도 함께 공개된다)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
ROOT_ADMIN_EMAIL=root@example.com
ROOT_ADMIN_PASSWORD=

# CORS 허용 출처 (쉼표 구분). 배포 도메인을 여기에 넣는다.
FRONTEND_ORIGINS=http://localhost:5173
# ngrok 와일드카드·사설 IP 대역까지 허용할지 여부. 개발할 때만 true.
CORS_ALLOW_DEV_ORIGINS=false
# 리버스 프록시(Caddy 등) 단 수. 프록시 뒤에서 실제 클라이언트 IP를 얻는 데 쓴다.
TRUST_PROXY_HOPS=1

# 레이트 리밋
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERAL_MAX=300

# Auth and QR signing
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
QR_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
QR_SLOT_SECONDS=10
# Demo-only QR allowlist. These tickets ignore the game-time window,
# but still rotate QR tokens by QR_SLOT_SECONDS.
QR_DEMO_ALWAYS_ON_GAME_IDS=PRACTICE_ALL_DAY_GAME
# Demo-only raffle allowlist. These games stay open on the raffle page
# for presentations, even after the normal apply window would close.
RAFFLE_DEMO_ALWAYS_OPEN_GAME_IDS=PRESENTATION_RAFFLE_ALWAYS_ON
# Presentation seed helper. Keep disabled outside the demo server.
DEMO_PRESENTATION_AUTO_GRANT=false
DEMO_PRESENTATION_EMAILS=demo1@example.com,demo2@example.com

# Privacy salt for DID/wallet hashing.
# Use the same value where Fabric chaincode/server hashing must match.
DID_PEPPER=CHANGE_ME_TO_A_LONG_RANDOM_PEPPER

# Fabric mode: mock for local development, real for a running Fabric network.
FABRIC_MODE=mock

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/

# Local testing helpers
DEBUG_TIME_OFFSET_HOURS=0
QR_HOURS_BEFORE=2

# On-chain NFT settings
# Oracle demo should keep this false. Set true only after security review and user approval.
ENABLE_ONCHAIN_MINTING=false
MINTER_PRIVATE_KEY=YOUR_MINTER_PRIVATE_KEY
FRAGMENT_NFT_ADDRESS=YOUR_FRAGMENT_NFT_ADDRESS
TICKET_NFT_ADDRESS=YOUR_TICKET_NFT_ADDRESS
BOX_NFT_ADDRESS=YOUR_BOX_NFT_ADDRESS
TICKET_MARKETPLACE_ADDRESS=YOUR_TICKET_MARKETPLACE_ADDRESS

# Toss Payments
# mock: local test payments do not call Toss approve/cancel APIs.
# real: requires a valid Toss secret key and can approve real/test Toss payments.
TOSS_MODE=mock
TOSS_CLIENT_KEY=YOUR_TOSS_CLIENT_KEY
TOSS_SECRET_KEY=YOUR_TOSS_SECRET_KEY

# Oracle/demo only: accept demo mock listing signatures when Fabric/Toss are both mock.
# Keep false for real production.
DEMO_ALLOW_MOCK_SIGNATURE=false
